# Add ONLY to Recruiter-Na's existing trusted-TLS server block.
# Replace its old static /recruiter-resumes/ alias; never expose original files.
location ^~ /recruiter-resumes/ {
    proxy_pass http://127.0.0.1:18891;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_buffering off;
    access_log off;
    error_log /dev/null;
}
