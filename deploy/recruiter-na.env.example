# Recruiter-Na v5.0.2 — never commit real secrets.

APP_ENV=production
RN_BACKEND=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Hiring-manager workflow persistence
RECRUITER_REQUEST_DB=/opt/recruiter-na/app/workspace/hiring_manager_requests.sqlite3
RECRUITER_SCREEN_POOL_LIMIT=30
RECRUITER_DECISION_WORKERS=3
RECRUITER_INTAKE_LLM_TIMEOUT_SECONDS=45

# Candidate Decision interactive LLM budget. Blank MODEL/FALLBACK values reuse
# the general LLM settings, but the runtime prefers configured flash/fast fallbacks.
RECRUITER_DECISION_MODEL=
RECRUITER_DECISION_FALLBACK_MODELS=
RECRUITER_DECISION_TIMEOUT_SECONDS=15
RECRUITER_DECISION_MAX_ATTEMPTS=1
RECRUITER_DECISION_MAX_MODELS=2
# strict = 同一份简历跑两次独立语义评估，判据不一致时退回 unknown（待核实），
# 把模型采样噪声挡在决策之外；off = 只跑一遍（省一半 token，但实测约 6% 候选人的决策会在两次运行间翻转）。
RECRUITER_DECISION_CONSISTENCY=strict

# Semantic/profile-match LLM (Responses-compatible or chat-compatible)
RECRUITER_LLM_BASE_URL=
RECRUITER_LLM_MODEL=
RECRUITER_LLM_API_MODE=responses
RECRUITER_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
RECRUITER_LLM_TIMEOUT_SECONDS=60
RECRUITER_MAX_RESUME_CHARS=120000
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Python 子进程编码：缺失时 Windows 会按控制台代码页输出，钉钉里就会看到乱码。
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Codex Harness runtime
CODEX_BIN=codex
CODEX_HOME=/opt/recruiter-na/codex-home
CODEX_WORKDIR=/opt/recruiter-na/app
CODEX_SANDBOX=workspace-write

# DingTalk Stream bot
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AI_CARD_TEMPLATE_ID=
DINGTALK_PROGRESS_CARD=true
DINGTALK_PROGRESS_THROTTLE_MS=800

# Selected-candidate resume delivery (owner-scoped, read-only source).
# The delivery service refuses any file outside these roots, and an empty list
# disables resume delivery entirely. Separate multiple roots with ':'.
RECRUITER_RESUME_SOURCE_ROOTS=
RECRUITER_RESUME_MAX_BYTES=20971520

# Public static resume fallback is disabled. Legacy RECRUITER_RESUME_URL_BASE
# and RECRUITER_RESUME_URL_DIR are ignored. Do not serve original resumes publicly.

# Mail intake (independent HR resume-ingestion workflow, optional)
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_PORT=993
MAILBOX_USERNAME=
MAILBOX_PASSWORD=
MAILBOX_FOLDER=INBOX

# Expiring resume links, enabled only after TLS and original-file validation.
# link: possession permits download (including forwarding), no OAuth configuration.
# corporate/owner: optional stricter modes requiring OAuth callback configuration.
RECRUITER_RESUME_DOWNLOAD_ENABLED=false
RECRUITER_RESUME_DOWNLOAD_BASE_URL=https://your-domain.example/recruiter-resumes
RECRUITER_RESUME_DOWNLOAD_DB=/opt/recruiter-na/state/resume_downloads.sqlite3
RECRUITER_RESUME_DOWNLOAD_PORT=18891
# corporate: verified same-company readers; owner: requires member-mapping permission.
RECRUITER_RESUME_DOWNLOAD_ACCESS=link
# Either pin CORP_ID explicitly or bind it from trusted Stream metadata.
RECRUITER_DINGTALK_CORP_ID=
RECRUITER_RESUME_DOWNLOAD_TENANT_FILE=/opt/recruiter-na/state/download_tenant.json
